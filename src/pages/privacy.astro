---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Privacy | Druckers Mart">
  <div class="container">
    <section class="content-hero">
      <div class="content-hero__inner">
        <p class="eyebrow">Privacy</p>
        <h1>Privacy Information</h1>
        <p class="lede">Druckers Mart Private Limited operates this B2B catalogue. We use information provided via enquiries only to respond to your availability and quotation requests. We do not sell or share your contact details.</p>
        <a class="button button--secondary" href="/enquiry">Return to enquiry</a>
      </div>
    </section>
  </div>
</SiteLayout>
