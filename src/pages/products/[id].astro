---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AvailabilityBadge from '../../components/AvailabilityBadge.astro';
import ProductCard from '../../components/ProductCard.astro';
import { publicProducts, productCategoryLabel } from '../../data/products';
import { availabilityLabel } from '../../lib/availability';

export function getStaticPaths() {
  return publicProducts().map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const allProducts = publicProducts();
const verifiedSpecs = Object.entries(product.specs ?? {}).filter(([, field]) => field.verified);
const relatedProducts = allProducts.filter((candidate) => candidate.category === product.category && candidate.id !== product.id).slice(0, 3);
const categoryLabel = productCategoryLabel(product.category);
const initials = product.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
const whatsappMsg = encodeURIComponent(`Hi Druckers Mart, I would like to enquire about ${product.name}.`);
const whatsappUrl = `https://wa.me/919968275213?text=${whatsappMsg}`;
const availabilityDisplay = availabilityLabel(product.availability_status);
const schemaAvailability = product.availability_status === 'in_stock' ? 'https://schema.org/InStock' : 'https://schema.org/LimitedAvailability';
---
<SiteLayout title={`${product.name} | Druckers Mart`}>
  <div class="container product-page">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": product.name,
      "description": "Availability, lead time and delivery are confirmed after enquiry.",
      "sku": product.id,
      "category": categoryLabel,
      "offers": {
        "@type": "Offer",
        "availability": schemaAvailability,
        "url": `https://druckersmart.com/products/${product.id}`,
        "seller": {
          "@type": "Organization",
          "name": "Druckers Mart Private Limited"
        }
      }
    })} />
    
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/products">Products</a>
      <span aria-hidden="true">/</span>
      <a href={`/products?category=${product.category}`}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="product-detail-layout">
      <main class="product-detail-main">
        <header class="product-header">
          {product.imagePath ? (
            <div class="product-header__image">
              <img src={product.imagePath} alt={product.name} loading="eager" />
            </div>
          ) : (
            <div class={`product-header__image product-placeholder product-placeholder--${product.category}`}>{initials}</div>
          )}
          <p class="eyebrow">{categoryLabel}</p>
          <h1 class="product-title">{product.name}</h1>
          <AvailabilityBadge status={product.availability_status} />
          <p class="availability-label">{availabilityDisplay}</p>
        </header>

        {verifiedSpecs.length > 0 && (
          <section class="product-specs" aria-labelledby="specs-title">
            <h2 id="specs-title" class="visually-hidden">Key specifications</h2>
            <dl class="specs-grid">
              {verifiedSpecs.map(([key, field]) => (
                <div class="spec-item">
                  <dt>{key.replaceAll('_', ' ')}</dt>
                  <dd>{field.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <section class="product-description" aria-labelledby="desc-title">
          <h2 id="desc-title">Product information</h2>
          <p>{product.application?.verified ? product.application.value : 'This product is sourced for production workflows. Exact availability, pricing, and delivery are confirmed after enquiry.'}</p>
        </section>

        <div class="product-cta-group">
          <a class="button" href={`/enquiry?product=${product.id}`}>Request Quote</a>
          <a class="button button--secondary whatsapp-btn" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp Enquiry</a>
        </div>
      </main>

      <aside class="product-detail-aside" aria-labelledby="aside-title">
        <section class="aside-panel" id="aside-title">
          <h3>Procurement Information</h3>
          <p>Listed products can be sourced on demand. Exact availability, lead time, and delivery are confirmed after your enquiry.</p>
          <ul class="availability-list">
            <li><strong>Lead time:</strong> Up to 7 business days</li>
            <li><strong>Logistics:</strong> Communicated on request</li>
          </ul>
        </section>
        <div class="aside-cta">
          <a class="button" href={`/enquiry?product=${product.id}`}>Request Quote</a>
        </div>
      </aside>
    </div>

    {relatedProducts.length > 0 && (
      <section class="related-products" aria-labelledby="related-title">
        <h2 id="related-title">Related products</h2>
        <div class="grid related-grid">{relatedProducts.map((product) => <ProductCard product={product} />)}</div>
      </section>
    )}
  </div>
</SiteLayout>

<style>
  .product-page { padding-block: var(--space-xl); }
  .breadcrumbs { display: flex; gap: var(--space-sm); font-size: var(--text-sm); margin-bottom: var(--space-lg); }
  
  .product-detail-layout {
    display: grid;
    grid-template-columns: 1fr minmax(auto, 350px);
    gap: var(--space-2xl);
    align-items: start;
  }
  
  .product-header__image { margin-bottom: var(--space-lg); border-radius: var(--radius-md); overflow: hidden; }
  .product-header__image img { width: 100%; height: auto; border: 1px solid var(--line); }
  .product-placeholder { height: 300px; display: grid; place-items: center; color: var(--white); font-size: 4rem; }
  
  .product-title { margin: var(--space-sm) 0 var(--space-md); font-size: var(--text-4xl); }
  .availability-label { margin: var(--space-xs) 0 0; font-size: var(--text-sm); color: #64748b; }
  
  .product-specs { margin-bottom: var(--space-xl); padding: var(--space-lg); background: var(--off-white); border-radius: var(--radius-md); }
  .specs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-md); margin: 0; }
  .spec-item { display: flex; flex-direction: column; gap: var(--space-xs); }
  .spec-item dt { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--mineral-blue); letter-spacing: 0.05em; }
  .spec-item dd { margin: 0; font-weight: 600; color: var(--graphite); }
  
  .product-description { margin-bottom: var(--space-xl); line-height: 1.6; }
  
  .product-cta-group { display: flex; gap: var(--space-md); margin-bottom: var(--space-2xl); }
  .product-cta-group .button { flex: 1; justify-content: center; }
  .whatsapp-btn { color: #25D366; border-color: #25D366; }
  
  .aside-panel { position: sticky; top: var(--space-lg); background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-md); padding: var(--space-lg); box-shadow: var(--shadow-base); }
  .aside-panel h3 { margin-top: 0; font-size: var(--text-lg); }
  
  .related-products { margin-top: var(--space-2xl); padding-top: var(--space-2xl); border-top: 1px solid var(--line); }
  .related-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  
  @media (max-width: 900px) {
    .product-detail-layout { grid-template-columns: 1fr; }
  }
</style>
