---
import SiteLayout from '../layouts/SiteLayout.astro';
const commit = import.meta.env.COMMIT_SHA || "unknown";
const version = "0.7.0";
---
<SiteLayout title="Site Version | Druckers Mart">
  <div class="container">
    <h1>Druckers Mart</h1>
    <p>Version: {version}</p>
    <p>Commit: {import.meta.env.SOURCE_COMMIT}</p>
    <p>Branch: master</p>
  </div>
</SiteLayout>
