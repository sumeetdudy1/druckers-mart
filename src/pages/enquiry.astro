---
import SiteLayout from '../layouts/SiteLayout.astro';
import AvailabilityPanel from '../components/AvailabilityPanel.astro';
import { publicProducts } from '../data/products';
import { ENQUIRY_ENDPOINT } from '../lib/api-config';

const products = publicProducts();
const selectedId = Astro.url.searchParams.get('product') ?? '';
const selected = products.find((product) => product.id === selectedId);
---
<SiteLayout title="Request a quote | Druckers Mart">
  <div class="container enquiry-page">
    <section class="hero enquiry-hero">
      <h1 class="industrial-heading">Tell us what you need.</h1>
      {selected ? (
        <div class="product-banner-industrial">
          <span class="font-mono text-[10px] tracking-wider text-slate-500 uppercase block mb-1">SELECTED_PRODUCT</span>
          <h3 class="text-xl font-bold">{selected.name}</h3>
        </div>
      ) : (
        <p class="lede">Share the product, quantity and delivery location. Availability is confirmed after your enquiry or order.</p>
      )}
      <p class="demo-notice font-mono text-xs text-slate-500 mt-2">Enquiries are sent to our team at druckersmart@gmail.com. We aim to respond within one business day.</p>
    </section>

    <form class="enquiry-form-industrial" id="enquiry-form" method="post" action={ENQUIRY_ENDPOINT}>
      <ol class="form-steps-industrial" aria-label="Enquiry stages">
        <li class="form-step-industrial form-step-industrial--active"><span class="font-mono">01 //</span> REQUIREMENT</li>
        <li class="form-step-industrial"><span class="font-mono">02 //</span> BUYER_DETAILS</li>
        <li class="form-step-industrial"><span class="font-mono">03 //</span> SUBMIT_ENQUIRY</li>
      </ol>

      <div class="form-grid-industrial">
        <fieldset class="form-panel-industrial">
          <legend class="industrial-heading text-lg font-bold border-b border-line pb-2 mb-4">01. REQUIREMENT_DETAILS</legend>

          <div class="field-group">
            <label for="product_id" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Product</label>
            <select id="product_id" name="product_id">
              <option value="">I am enquiring about a general requirement</option>
              {products.map((product) => <option value={product.id} selected={product.id === selected?.id}>{product.name}</option>)}
            </select>
          </div>

          <div class="field-group">
            <label for="quantity_requirement" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Quantity or requirement <span aria-hidden="true" class="text-orange-600">*</span></label>
            <input id="quantity_requirement" name="quantity_requirement" required />
          </div>

          <div class="field-group">
            <label for="delivery_location" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Delivery location <span aria-hidden="true" class="text-orange-600">*</span></label>
            <input id="delivery_location" name="delivery_location" required />
          </div>

          <div class="field-group">
            <label for="required_by_date" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Required by date</label>
            <input id="required_by_date" name="required_by_date" type="date" />
          </div>

          <div class="field-group">
            <label for="additional_notes" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Additional notes</label>
            <textarea id="additional_notes" name="additional_notes" rows="4"></textarea>
          </div>
        </fieldset>

        <fieldset class="form-panel-industrial">
          <legend class="industrial-heading text-lg font-bold border-b border-line pb-2 mb-4">02. BUYER_DETAILS</legend>

          <div class="field-group">
            <label for="buyer_name" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Your name <span aria-hidden="true" class="text-orange-600">*</span></label>
            <input id="buyer_name" name="buyer_name" required autocomplete="name" />
          </div>

          <div class="field-group">
            <label for="company" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Company</label>
            <input id="company" name="company" autocomplete="organization" />
          </div>

          <div class="field-group">
            <label for="work_email" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Work email <span aria-hidden="true" class="text-orange-600">*</span></label>
            <input id="work_email" name="work_email" type="email" required autocomplete="email" />
          </div>

          <div class="field-group">
            <label for="phone" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Phone <span aria-hidden="true" class="text-orange-600">*</span></label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" />
          </div>

          <div class="check">
            <input type="checkbox" id="consent_contact" name="consent_contact" value="true" required />
            <label for="consent_contact" class="text-xs text-slate-600">I agree that Druckers Mart may use these details to respond to this enquiry.</label>
          </div>
          <p class="form-help text-xs text-slate-500 mt-2">See the <a href="/privacy" class="underline">Privacy Policy</a>.</p>
          <input type="hidden" name="privacy_policy_version" value="demo-v1" />
          <input type="hidden" name="form_started_at" id="form_started_at" />
          <label class="honeypot" aria-hidden="true">Leave this field empty<input name="honeypot" id="honeypot" tabindex="-1" autocomplete="off" /></label>
        </fieldset>
      </div>

      <button class="button" type="submit" id="submit-button">Submit enquiry</button>

      <div id="error-panel" class="notice-industrial notice-industrial--error" hidden role="alert">
        <p class="font-bold mb-1">We couldn't submit your enquiry right now.</p>
        <p class="text-sm mb-4">Please try again or contact us directly:</p>
        <p class="text-sm"><a href="tel:+919****5213" class="underline">Call us: +91 99682 75213</a> · <a href="https://wa.me/919968275213" class="underline">WhatsApp</a> · <a href="mailto:druckersmart@gmail.com" class="underline">Email</a></p>
      </div>
      <p class="form-status font-mono text-xs" id="form-status" role="status" hidden></p>
    </form>

    <section class="notice-industrial notice-industrial--success" id="success-panel" hidden aria-labelledby="success-title">
      <h2 id="success-title" class="industrial-heading text-2xl font-bold mb-2">Enquiry received</h2>
      <p class="text-slate-700 mb-6">Thanks for contacting Druckers Mart. Our team will review your requirement and get back to you.</p>
      <div class="actions">
        <a class="button" href="/products">Back to Products</a>
        <a class="button button--secondary" href="https://wa.me/919968275213" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </section>

    <AvailabilityPanel />
  </div>
</SiteLayout>

<script is:inline>
  const ENQUIRY_ENDPOINT = "https://api.druckersmart.com/api/enquiries";
  const form = document.querySelector('#enquiry-form');
  const success = document.querySelector('#success-panel');
  const errorPanel = document.querySelector('#error-panel');
  const started = document.querySelector('#form_started_at');
  const submitButton = document.querySelector('#submit-button');
  const honeypot = document.querySelector('#honeypot');

  if (started) started.value = new Date().toISOString();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (honeypot && honeypot.value !== '') {
        console.error('Honeypot triggered');
        return;
    }

    if (!form?.checkValidity()) { form?.reportValidity(); return; }

    if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';
    }
    if (errorPanel) errorPanel.setAttribute('hidden', 'true');

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      const payload = {
        product_id: data.product_id || null,
        quantity_requirement: data.quantity_requirement,
        delivery_location: data.delivery_location,
        required_by_date: data.required_by_date || null,
        additional_notes: data.additional_notes || null,
        buyer_name: data.buyer_name,
        company: data.company || null,
        work_email: data.work_email,
        phone: data.phone,
        consent_contact: data.consent_contact === 'true',
        privacy_policy_version: data.privacy_policy_version,
        honeypot: data.honeypot || null,
        form_started_at: data.form_started_at
      };

      const response = await fetch(ENQUIRY_ENDPOINT, {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
      }).catch(err => {
        console.error('Fetch error:', err);
        return { ok: false, status: 0, text: () => Promise.resolve(err.message) };
      });

      if (response.ok) {
        form.classList.add('hidden-form');
        success?.removeAttribute('hidden');
      } else {
        const text = await response.text();
        throw new Error('Submission failed: ' + text);
      }
    } catch (err) {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Submit enquiry';
      }
      if (errorPanel) errorPanel.removeAttribute('hidden');
    }
  });
</script>

<style>
  .enquiry-page { padding-block: var(--space-2xl); }
  .enquiry-hero { margin-bottom: var(--space-2xl); }

  .enquiry-form-industrial { display: grid; gap: var(--space-xl); }

  /* Progress Rail */
  .form-steps-industrial { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; list-style: none; padding: 0; background: var(--line); border: 1px solid var(--line); margin-bottom: var(--space-xl); }
  .form-step-industrial { padding: 1.25rem; background: var(--white); color: #64748b; font-weight: 700; font-size: var(--text-sm); display: flex; gap: var(--space-sm); align-items: center; }
  .form-step-industrial--active { color: var(--graphite); background: var(--off-white); border-bottom: 2px solid var(--signal-orange); }
  .form-step-industrial span { color: var(--signal-orange); }

  /* Form Layout */
  .form-grid-industrial { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); align-items: start; }
  .form-panel-industrial { display: grid; gap: var(--space-md); border: 1px solid var(--line); padding: 2rem; background: var(--white); margin: 0; }
  .form-panel-industrial legend { padding-inline: 0; }

  .field-group { display: grid; gap: var(--space-xs); }

  input, select, textarea { width: 100%; border: 1px solid var(--line); border-radius: 0; padding: var(--space-sm); font: inherit; min-height: 2.75rem; background: var(--white); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--signal-orange); outline-offset: 2px; }

  .check { display: flex; gap: var(--space-sm); align-items: flex-start; margin-top: var(--space-sm); }
  .check input { width: auto; min-height: 1.2rem; }

  /* Success / Error States */
  .notice-industrial { border: 1px solid var(--line); padding: 2.5rem; background: var(--white); }
  .notice-industrial--success { border-color: var(--status-green); }
  .notice-industrial--error { border-color: var(--signal-orange); }

  .product-banner-industrial { margin-bottom: var(--space-lg); padding: 1.5rem; border: 1px solid var(--line); background: var(--white); }

  .hidden-form { display: none !important; }

  @media (max-width: 900px) {
    .form-grid-industrial { grid-template-columns: 1fr; gap: var(--space-lg); }
    .form-steps-industrial { grid-template-columns: 1fr; gap: 1px; }
    .form-step-industrial { padding: 1rem; }
  }
</style>
