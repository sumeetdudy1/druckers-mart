---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import AvailabilityPanel from '../components/AvailabilityPanel.astro';
import { publicProducts } from '../data/products';
const category = Astro.url.searchParams.get('category') ?? '';
const availability = Astro.url.searchParams.get('availability') ?? '';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const normalizedQuery = query.toLowerCase();
const products = publicProducts().filter((product) => {
  const matchesCategory = !category || product.category === category;
  const matchesAvailability = !availability || product.availability_status === availability;
  const searchable = `${product.name} ${product.category} ${Object.values(product.specs ?? {}).map((field) => field.value).join(' ')}`.toLowerCase();
  return matchesCategory && matchesAvailability && (!normalizedQuery || searchable.includes(normalizedQuery));
});
const categoryLabels = { '': 'All stages', 'pre-press': 'Pre-press', press: 'Press', 'post-press': 'Post-press' };
---
<SiteLayout title="Products | Druckers Mart">
  <div class="container products-page">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": products.map((product, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Product",
          "name": product.name,
          "url": `https://druckersmart.com/products/${product.id}`,
          "sku": product.id,
          "category": product.category === 'pre-press' ? 'Pre-press' : product.category === 'post-press' ? 'Post-press' : 'Press'
        }
      }))
    })} />
    
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Products</span>
    </nav>

    <section class="hero products-hero">
      <p class="eyebrow">Catalogue</p>
      <h1 class="industrial-heading">Products by production stage.</h1>
      <p class="lede">Browse our industrial procurement catalogue. Availability confirmed on enquiry.</p>
    </section>

    <form class="filters-industrial" method="get" action="/products" aria-label="Filter products">
      <div class="filter-group">
        <label for="q" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Search</label>
        <input type="search" id="q" name="q" value={query} placeholder="Search products..." class="w-full" />
      </div>
      <div class="filter-group">
        <label for="category" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Stage</label>
        <select id="category" name="category" class="w-full">
          <option value="">All stages</option>
          <option value="pre-press" selected={category === 'pre-press'}>Pre-press</option>
          <option value="press" selected={category === 'press'}>Press</option>
          <option value="post-press" selected={category === 'post-press'}>Post-press</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="availability" class="font-mono text-[10px] tracking-wider text-slate-500 uppercase">Status</label>
        <select id="availability" name="availability" class="w-full">
          <option value="">All statuses</option>
          <option value="availability_to_be_confirmed" selected={availability === 'availability_to_be_confirmed'}>To be confirmed</option>
          <option value="in_stock" selected={availability === 'in_stock'}>In Stock</option>
        </select>
      </div>
      <div class="filter-actions-industrial">
        <button class="button button--small" type="submit">Apply</button>
        <a class="button button--small button--secondary" href="/products">Clear</a>
      </div>
    </form>

    <p class="result-count font-mono text-sm border-b border-line pb-4 mb-8" id="result-count" role="status" aria-live="polite">
      {products.length} product{products.length === 1 ? '' : 's'} · {categoryLabels[category as keyof typeof categoryLabels] ?? 'Selected stage'}
    </p>

  <style>
    .filters-industrial { 
      display: grid; 
      grid-template-columns: 2fr 1fr 1fr auto; 
      gap: 1px; 
      background: var(--line); 
      border: 1px solid var(--line);
      margin-bottom: var(--space-md);
    }
    .filter-group { background: var(--white); padding: 0.75rem 1rem; }
    .filter-group label { display: block; margin-bottom: 0.25rem; }
    .filter-group input, .filter-group select { 
      border: 1px solid var(--line); 
      padding: 0.25rem 0.5rem; 
      font: inherit; 
      background: var(--white); 
      border-radius: var(--radius-sm);
      height: 2rem;
      width: 100%;
    }
    .filter-actions-industrial { background: var(--white); padding: 0.75rem 1rem; display: flex; align-items: end; gap: 0.5rem; }
    
    @media (max-width: 800px) { 
      .filters-industrial { grid-template-columns: 1fr; } 
      .filter-actions-industrial { justify-content: start; }
    }
  </style>

    <div class="grid" id="product-grid">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
    
    <div class="notice" id="no-results" hidden={products.length > 0}>
      <h2>No matching products</h2>
      <p>Try clearing a filter or tell us what you need.</p>
      <a class="button" href="/enquiry">Request availability</a>
    </div>
    
    <AvailabilityPanel />
  </div>
</SiteLayout>

<script>
  const filterForm = document.querySelector('.filters-industrial') as HTMLFormElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-product-card]')];
  const resultCount = document.querySelector('#result-count');
  const noResults = document.querySelector('#no-results') as HTMLElement | null;
  const urlParams = new URLSearchParams(location.search);
  if (filterForm) {
    ['q', 'category', 'availability'].forEach((name) => {
      const field = filterForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (field) field.value = urlParams.get(name) ?? '';
    });
  }
  const categoryLabels = { '': 'All stages', 'pre-press': 'Pre-press', press: 'Press', 'post-press': 'Post-press' };
  const applyFilters = () => {
    const values = new FormData(filterForm ?? undefined);
    const query = String(values.get('q') ?? '').trim().toLowerCase();
    const category = String(values.get('category') ?? '');
    const availability = String(values.get('availability') ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const matches = (!query || (card.dataset.search ?? '').includes(query))
        && (!category || card.dataset.category === category)
        && (!availability || card.dataset.availability === availability);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (resultCount) {
      const label = categoryLabels[category as keyof typeof categoryLabels] ?? 'Selected stage';
      resultCount.textContent = `${visible} product${visible === 1 ? '' : 's'} · ${label}`;
    }
    if (noResults) noResults.hidden = visible !== 0;
  };
  filterForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const params = new URLSearchParams();
    new FormData(filterForm).forEach((value, key) => params.set(key, String(value)));
    history.replaceState(null, '', `${location.pathname}?${params.toString()}`);
    applyFilters();
  });
  filterForm?.addEventListener('input', applyFilters);
  applyFilters();
</script>

<style>
  .products-page { padding-bottom: var(--space-2xl); }
  .products-hero { padding-block: var(--space-xl) var(--space-lg); }
    
  .filters-industrial { 
    display: grid; 
    grid-template-columns: 2fr 1fr 1fr auto; 
    gap: 1px; 
    background: var(--line); 
    border: 1px solid var(--line);
    margin-bottom: var(--space-md);
  }
  .filter-group { background: var(--white); padding: 0.75rem 1rem; }
  .filter-group label { display: block; margin-bottom: 0.25rem; }
  .filter-group input, .filter-group select { 
    border: 1px solid var(--line); 
    padding: 0.25rem 0.5rem; 
    font: inherit; 
    background: var(--white); 
    border-radius: var(--radius-sm);
    height: 2rem;
    width: 100%;
  }
  .filter-actions-industrial { background: var(--white); padding: 0.75rem 1rem; display: flex; align-items: end; gap: 0.5rem; }
    
  @media (max-width: 800px) { 
    .filters-industrial { grid-template-columns: 1fr; } 
    .filter-actions-industrial { justify-content: start; }
  }
</style>
