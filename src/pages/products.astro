---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import AvailabilityPanel from '../components/AvailabilityPanel.astro';
import { publicProducts } from '../data/products';

const category = Astro.url.searchParams.get('category') ?? '';
const availability = Astro.url.searchParams.get('availability') ?? '';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const normalizedQuery = query.toLowerCase();
const products = publicProducts().filter((product) => {
  const matchesCategory = !category || product.category === category;
  const matchesAvailability = !availability || product.availability_status === availability;
  const searchable = `${product.name} ${product.category} ${Object.values(product.specs ?? {}).map((field) => field.value).join(' ')}`.toLowerCase();
  return matchesCategory && matchesAvailability && (!normalizedQuery || searchable.includes(normalizedQuery));
});
const categoryLabels = { '': 'All stages', 'pre-press': 'Pre-press', press: 'Press', 'post-press': 'Post-press' };
---
<SiteLayout title="Products | Druckers Mart">
  <div class="container">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": products.map((product, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Product",
          "name": product.name,
          "url": `https://druckersmart.com/products/${product.id}`,
          "sku": product.id,
          "category": product.category === 'pre-press' ? 'Pre-press' : product.category === 'post-press' ? 'Post-press' : 'Press'
        }
      }))
    })} />
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Products</span></nav>
    <section class="hero">
      <p class="eyebrow">Catalogue</p>
      <h1>Products by production stage.</h1>
      <p class="lede">Browse the initial catalogue. Products can be sourced on demand from Baddi; availability is confirmed after enquiry or order.</p>
    </section>
    <form class="filters" method="get" action="/products" aria-label="Filter products">
      <label for="q">Search products<input type="search" id="q" name="q" value={query} placeholder="Search by product or specification" /></label>
      <label for="category">Production stage<select id="category" name="category"><option value="">All stages</option><option value="pre-press" selected={category === 'pre-press'}>Pre-press</option><option value="press" selected={category === 'press'}>Press</option><option value="post-press" selected={category === 'post-press'}>Post-press</option></select></label>
      <label for="availability">Availability<select id="availability" name="availability"><option value="">All statuses</option><option value="availability_to_be_confirmed" selected={availability === 'availability_to_be_confirmed'}>Availability to be Confirmed</option><option value="in_stock" selected={availability === 'in_stock'}>In Stock</option></select></label>
      <button class="button" type="submit">Apply filters</button>
      <a class="button button--secondary" href="/products">Clear</a>
    </form>
    <p class="result-count" id="result-count" role="status" aria-live="polite">{products.length} product{products.length === 1 ? '' : 's'} · {categoryLabels[category as keyof typeof categoryLabels] ?? 'Selected stage'}</p>
    <AvailabilityPanel />
    <div class="grid" id="product-grid">{products.map((product) => <ProductCard product={product} />)}</div>
    <div class="notice" id="no-results" hidden={products.length > 0}><h2>No matching products</h2><p>Try clearing a filter or tell us what you need.</p><a class="button" href="/enquiry">Request availability</a></div>
  </div>
</SiteLayout>
<script>
  const filterForm = document.querySelector('.filters') as HTMLFormElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-product-card]')];
  const resultCount = document.querySelector('#result-count');
  const noResults = document.querySelector('#no-results') as HTMLElement | null;
  const urlParams = new URLSearchParams(location.search);
  if (filterForm) {
    ['q', 'category', 'availability'].forEach((name) => {
      const field = filterForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (field) field.value = urlParams.get(name) ?? '';
    });
  }
  const applyFilters = () => {
    const values = new FormData(filterForm ?? undefined);
    const query = String(values.get('q') ?? '').trim().toLowerCase();
    const category = String(values.get('category') ?? '');
    const availability = String(values.get('availability') ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const matches = (!query || (card.dataset.search ?? '').includes(query))
        && (!category || card.dataset.category === category)
        && (!availability || card.dataset.availability === availability);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (resultCount) resultCount.textContent = `${visible} product${visible === 1 ? '' : 's'} · filtered catalogue`;
    if (noResults) noResults.hidden = visible !== 0;
  };
  filterForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const params = new URLSearchParams();
    new FormData(filterForm).forEach((value, key) => params.set(key, String(value)));
    history.replaceState(null, '', `${location.pathname}?${params.toString()}`);
    applyFilters();
  });
  filterForm?.addEventListener('input', applyFilters);
  applyFilters();
</script>
<style>
  .breadcrumbs { display: flex; gap: .55rem; font-size: .9rem; margin-bottom: 1rem; }
  .filters { display: grid; grid-template-columns: minmax(14rem, 2fr) repeat(2, minmax(10rem, 1fr)) auto auto; gap: 1.5rem; align-items: end; margin-bottom: 2.5rem; padding: 1.5rem; background: #fff; border: 1px solid var(--line); border-radius: 8px; }
  .filters label { display: grid; gap: 0.5rem; font-weight: 700; font-size: 0.85rem; color: var(--mineral-blue); text-transform: uppercase; letter-spacing: 0.05em; }
  .filters input, .filters select { min-height: 3rem; border: 1px solid var(--line); padding: 0.75rem; font: inherit; background: #fff; border-radius: 4px; }
  .result-count { color: var(--mineral-blue); font-weight: 700; }
  @media (max-width: 800px) { .filters { grid-template-columns: 1fr 1fr; } .filters label:first-child { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .filters { grid-template-columns: 1fr; } .filters label:first-child { grid-column: auto; } .filters .button { width: 100%; justify-content: center; } }
</style>
