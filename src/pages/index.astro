---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { publicProducts } from '../data/products';
import { druckersBusiness } from '../data/druckers-business';
const products = publicProducts();
const featuredProducts = products.slice(0, 3);
const whatsappUrl = `https://wa.me/${druckersBusiness.whatsapp.replace('+', '')}`;
---
<SiteLayout title="Druckers Mart | Printing & Packaging Supplies">
  <section class="home-hero">
    <div class="container home-hero__container">
      <div class="home-hero__content">
        <h1 class="industrial-heading">Printing & Packaging Production Supplies.</h1>
        <p class="lede">Industrial consumables, sourced directly for commercial printing and packaging production.</p>
        <div class="actions">
          <a class="button" href="/enquiry">Request Quote</a>
          <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp Enquiry</a>
        </div>
      </div>
      <div class="home-hero__visual">
        <div class="industrial-asset-placeholder">
          <span>INDUSTRIAL PRODUCTION</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Unified Interaction */
    .industrial-card-hover { transition: transform var(--transition-fast), box-shadow var(--transition-fast); }
    .industrial-card-hover:hover { transform: translateY(-2px); box-shadow: var(--shadow-base); }

    /* Hero */
    .home-hero { padding-block: var(--space-2xl); border-bottom: 1px solid var(--line); overflow: hidden; }
    .home-hero__container { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: center; }
    .home-hero__content { display: grid; gap: var(--space-md); }
    .home-hero h1 { font-size: clamp(3rem, 6vw, 4.5rem); margin: 0; }
    .home-hero__visual { aspect-ratio: 4/3; background: var(--graphite); border-radius: var(--radius-lg); overflow: hidden; position: relative; }
    .industrial-asset-placeholder { width: 100%; height: 100%; display: grid; place-items: center; color: var(--white); font-weight: 800; letter-spacing: 0.1em; opacity: 0.8; }
    
    @media (max-width: 800px) {
      .home-hero__container { grid-template-columns: 1fr; gap: var(--space-xl); }
      .home-hero__visual { aspect-ratio: 16/9; }
    }
  </style>

  <div class="container home-stack">
    <aside class="supply-board" aria-label="Druckers Mart supply focus">
      <div class="supply-board__topline">Production supply desk</div>
      <div class="supply-board__grid">
        <div class="supply-board__item"><span>01</span><strong>Pre-press</strong><small>CTP inputs</small></div>
        <div class="supply-board__item"><span>02</span><strong>Press</strong><small>Inks, wash</small></div>
        <div class="supply-board__item"><span>03</span><strong>Post-press</strong><small>Finishing</small></div>
      </div>
    </aside>

    <section aria-labelledby="value-title" class="value-section">
      <div class="section-heading">
        <h2 id="value-title" class="industrial-heading">Built around practical buying needs.</h2>
      </div>
      <div class="value-grid-industrial">
        <article class="value-card-industrial">
          <span class="font-mono text-sm block mb-1 text-orange-600">01. PRODUCTION_SUPPLIES</span>
          <p>Catalogue organised around the supplies used in print and packaging production.</p>
        </article>
        <article class="value-card-industrial">
          <span class="font-mono text-sm block mb-1 text-orange-600">02. B2B_SOURCING</span>
          <p>Enquiry-led buying flow for companies, procurement teams and commercial buyers.</p>
        </article>
        <article class="value-card-industrial">
          <span class="font-mono text-sm block mb-1 text-orange-600">03. AVAILABILITY_ENQUIRY</span>
          <p>No live stock claims or price claims. Availability confirmed post-enquiry.</p>
        </article>
        <article class="value-card-industrial">
          <span class="font-mono text-sm block mb-1 text-orange-600">04. LOCATION_BADDI</span>
          <p>Druckers Mart Private Limited, based in Baddi, Solan, Himachal Pradesh, India.</p>
        </article>
      </div>
    </section>

  <style>
    .value-section { padding-block: var(--space-2xl); border-top: 1px solid var(--line); }
    .value-grid-industrial { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
    .value-card-industrial { background: var(--white); padding: 2rem; display: flex; flex-direction: column; }
    .value-card-industrial p { margin: 0; line-height: 1.5; color: #4a545a; font-size: 0.95rem; }
    
    @media (max-width: 800px) {
      .value-grid-industrial { grid-template-columns: 1fr; }
    }
  </style>

    <section aria-labelledby="stages-title" class="stages-section">
      <div class="section-heading section-heading--split">
        <div>
          <h2 id="stages-title" class="industrial-heading">Find supply by workflow stage.</h2>
        </div>
        <a class="text-link" href="/products">View all products →</a>
      </div>
      <div class="production-rail" aria-label="Production stages: Pre-press, Press, and Post-press">
        {[
          ['pre-press', 'Pre-press', 'Plates and CTP inputs'],
          ['press', 'Press', 'Inks, wash and press supplies'],
          ['post-press', 'Post-press', 'Finishing and packaging supplies'],
        ].map(([stage, label, description], index) => <div class="production-rail__step">
          <div class="production-rail__identifier">
            <span class="production-rail__number font-mono">0{index + 1}</span>
            {index < 2 && <div class="production-rail__connector"></div>}
          </div>
          <div class="production-rail__content industrial-card-hover">
            <h3 class="text-xl">{label}</h3>
            <p class="text-sm text-gray-700 mb-4">{description}</p>
            <a class="button button--secondary" href={`/products?category=${stage}`}>Explore catalogue</a>
          </div>
        </div>)}
      </div>
    </section>

  <style>
    .stages-section { padding-block: var(--space-2xl); border-top: 1px solid var(--line); }
    .production-rail { display: flex; flex-direction: column; gap: 0; }
    .production-rail__step { display: grid; grid-template-columns: 80px 1fr; gap: 2rem; }
    .production-rail__identifier { display: flex; flex-direction: column; align-items: center; position: relative; }
    .production-rail__number { width: 48px; height: 48px; display: grid; place-items: center; background: var(--white); border: 2px solid var(--line); color: var(--signal-orange); font-weight: 800; border-radius: 4px; z-index: 1; }
    .production-rail__connector { flex: 1; width: 1px; background: var(--line); margin: 8px 0; }
    .production-rail__content { padding: 2rem; background: var(--white); border: 1px solid var(--line); margin-bottom: 1rem; }
    
    @media (max-width: 800px) {
      .production-rail__step { grid-template-columns: 40px 1fr; gap: 1rem; }
      .production-rail__number { width: 32px; height: 32px; font-size: 0.8rem; }
      .production-rail__content { padding: 1.5rem; }
    }
  </style>

    <section aria-labelledby="featured-title" class="featured-section">
      <div class="section-heading">
        <h2 id="featured-title" class="industrial-heading">Featured Catalogue</h2>
      </div>
      <div class="featured-industrial-composition">
        <div class="featured-lead">
          {featuredProducts.length > 0 ? <ProductCard product={featuredProducts[0]} /> : <div class="notice">Catalogue update pending.</div>}
        </div>
        <div class="featured-secondary">
          {featuredProducts.slice(1).map((product) => <ProductCard product={product} />)}
          <a class="text-link" href="/products">View full catalogue →</a>
        </div>
      </div>
    </section>

  <style>
    .featured-section { padding-block: var(--space-2xl); border-top: 1px solid var(--line); }
    .featured-industrial-composition { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-xl); align-items: start; }
    .featured-lead .card { height: 100%; border-width: 2px; }
    .featured-secondary { display: grid; gap: var(--space-md); }
    
    @media (max-width: 800px) {
      .featured-industrial-composition { grid-template-columns: 1fr; }
    }
  </style>

    <section aria-labelledby="how-title">
      <div class="section-heading">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">Simple enquiry flow.</h2>
      </div>
      <div class="process-grid">
        <article><span>01</span><h3>Find a product</h3><p>Browse by product name, production stage or listed specification.</p></article>
        <article><span>02</span><h3>Check availability</h3><p>Share your requirement, quantity and delivery location.</p></article>
        <article><span>03</span><h3>Request a quote</h3><p>The Druckers Mart team confirms availability, pricing and next steps after enquiry.</p></article>
      </div>
    </section>

    <section aria-labelledby="industries-title">
      <div class="section-heading">
        <p class="eyebrow">Use cases</p>
        <h2 id="industries-title">For printing and packaging operations.</h2>
      </div>
      <div class="use-case-list" aria-label="Industries and use cases">
        <span>Commercial Printing</span>
        <span>Packaging Printing</span>
        <span>Offset Printing</span>
        <span>Print Finishing</span>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <p class="eyebrow">Ready to enquire?</p>
      <h2 id="final-cta-title">Tell us the product, quantity and delivery location.</h2>
      <div class="actions">
        <a class="button" href="/enquiry">Request Quote</a>
        <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .home-hero { padding-block: var(--space-2xl); border-bottom: 1px solid var(--line); }
  .home-hero__content { max-width: 60ch; display: grid; gap: var(--space-sm); }
  .home-hero h1 { font-size: var(--text-4xl); margin: 0; line-height: 1.1; }
  .home-hero .lede { font-size: var(--text-xl); line-height: 1.5; color: #475569; }
  .home-stack { display: grid; gap: var(--space-2xl); padding-block: var(--space-xl); }
  
  .section-heading { margin-bottom: var(--space-xl); }
  .value-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-lg); border-top: 1px solid var(--line); padding-top: var(--space-xl); }
</style>
