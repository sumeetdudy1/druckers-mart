---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { publicProducts } from '../data/products';
import { druckersBusiness } from '../data/druckers-business';
const products = publicProducts();
const featuredProducts = products.slice(0, 4);
const whatsappUrl = `https://wa.me/${druckersBusiness.whatsapp.replace('+', '')}`;
---
<SiteLayout title="Druckers Mart | Printing & Packaging Supplies">
  <section class="home-hero">
    <div class="container">
      <div class="home-hero__content">
        <p class="eyebrow">B2B printing consumables · Baddi</p>
        <h1>Printing & Packaging Supplies, Sourced for Production.</h1>
        <p class="lede">Druckers Mart helps commercial printers and packaging buyers enquire for production supplies across pre-press, press and post-press workflows. Availability is confirmed after enquiry.</p>
        <div class="actions">
          <a class="button" href="/enquiry">Request Quote</a>
          <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <div class="container home-stack">
    <aside class="supply-board" aria-label="Druckers Mart supply focus">
      <div class="supply-board__topline">Production supply desk</div>
      <div class="supply-board__grid">
        <div class="supply-board__item"><span>01</span><strong>Pre-press</strong><small>CTP inputs</small></div>
        <div class="supply-board__item"><span>02</span><strong>Press</strong><small>Inks, wash</small></div>
        <div class="supply-board__item"><span>03</span><strong>Post-press</strong><small>Finishing</small></div>
      </div>
    </aside>

    <section aria-labelledby="value-title">
      <div class="section-heading">
        <p class="eyebrow">Value proposition</p>
        <h2 id="value-title">Built around practical buying needs.</h2>
      </div>
      <div class="value-grid">
        <article class="value-card"><span>Production Supplies</span><p>Catalogue organised around the supplies used in print and packaging production.</p></article>
        <article class="value-card"><span>B2B Sourcing</span><p>Enquiry-led buying flow for companies, procurement teams and commercial buyers.</p></article>
        <article class="value-card"><span>Availability on Enquiry</span><p>No live stock claims or price claims are shown. Availability is confirmed after enquiry.</p></article>
        <article class="value-card"><span>Baddi Based</span><p>Druckers Mart Private Limited is based in Baddi, Solan, Himachal Pradesh, India.</p></article>
      </div>
    </section>

    <section aria-labelledby="stages-title">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Production stages</p>
          <h2 id="stages-title">Find supply by workflow stage.</h2>
        </div>
        <a class="text-link" href="/products">View all products →</a>
      </div>
      <div class="production-signal" aria-label="Production stages: Pre-press, Press, and Post-press">
        {[
          ['pre-press', 'Pre-press', 'Plates and CTP inputs'],
          ['press', 'Press', 'Inks, wash and press supplies'],
          ['post-press', 'Post-press', 'Finishing and packaging supplies'],
        ].map(([stage, label, description], index) => <>
          <a class="stage-card" href={`/products?category=${stage}`} aria-label={`Explore ${label} products`}>
            <span class="stage-number">0{index + 1}</span>
            <h3>{label}</h3>
            <p>{description}</p>
            <span class="stage-link">Explore catalogue →</span>
          </a>
          {index < 2 && <span class="stage-arrow" aria-hidden="true">→</span>}
        </>)}
      </div>
    </section>

    <section aria-labelledby="featured-title">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Featured catalogue</p>
          <h2 id="featured-title">Actual products from the current catalogue.</h2>
          <p>Selected products; prices/stock are confirmed on enquiry.</p>
        </div>
        <a class="text-link" href="/products">Open catalogue →</a>
      </div>
      {featuredProducts.length > 0 ? <div class="grid featured-grid">{featuredProducts.map((product) => <ProductCard product={product} />)}</div> : <div class="notice"><p>Products are being confirmed for the initial Druckers catalogue.</p><a class="button button--secondary" href="/enquiry">Request availability</a></div>}
    </section>

    <section aria-labelledby="how-title">
      <div class="section-heading">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">Simple enquiry flow.</h2>
      </div>
      <div class="process-grid">
        <article><span>01</span><h3>Find a product</h3><p>Browse by product name, production stage or listed specification.</p></article>
        <article><span>02</span><h3>Check availability</h3><p>Share your requirement, quantity and delivery location.</p></article>
        <article><span>03</span><h3>Request a quote</h3><p>The Druckers Mart team confirms availability, pricing and next steps after enquiry.</p></article>
      </div>
    </section>

    <section aria-labelledby="industries-title">
      <div class="section-heading">
        <p class="eyebrow">Use cases</p>
        <h2 id="industries-title">For printing and packaging operations.</h2>
      </div>
      <div class="use-case-list" aria-label="Industries and use cases">
        <span>Commercial Printing</span>
        <span>Packaging Printing</span>
        <span>Offset Printing</span>
        <span>Print Finishing</span>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <p class="eyebrow">Ready to enquire?</p>
      <h2 id="final-cta-title">Tell us the product, quantity and delivery location.</h2>
      <div class="actions">
        <a class="button" href="/enquiry">Request Quote</a>
        <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </section>
  </div>
</SiteLayout>
