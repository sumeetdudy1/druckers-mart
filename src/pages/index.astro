---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { publicProducts } from '../data/products';
import { druckersBusiness } from '../data/druckers-business';
const products = publicProducts();
const featuredProducts = products.slice(0, 3);
const whatsappUrl = `https://wa.me/${druckersBusiness.whatsapp.replace('+', '')}`;
---
<SiteLayout title="Druckers Mart | Printing & Packaging Supplies">
    <section class="home-hero">
      <div class="container home-hero__container">
        <div class="home-hero__content">
          <h1 class="industrial-heading">Printing & Packaging Production Supplies.</h1>
          <p class="lede">Industrial consumables, sourced directly for commercial printing and packaging production.</p>
          <div class="actions">
            <a class="button" href="/enquiry">Request Quote</a>
            <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp Enquiry</a>
          </div>
        </div>
        <div class="home-hero__visual">
          <img src="/hero-material-macro.jpg" alt="Macro texture of premium printed packaging material" class="w-full h-full object-cover" />
        </div>
      </div>
    </section>

    <div class="container home-stack">
        <aside class="supply-board-editorial" aria-label="Druckers Mart supply focus">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4">Production supply desk</h2>
            <div class="supply-board-list">
                <div class="supply-board-item"><strong>Pre-press</strong><span class="text-xs text-slate-600">CTP inputs</span></div>
                <div class="supply-board-item"><strong>Press</strong><span class="text-xs text-slate-600">Inks, wash</span></div>
                <div class="supply-board-item"><strong>Post-press</strong><span class="text-xs text-slate-600">Finishing</span></div>
            </div>
        </aside>

        <section aria-labelledby="value-title" class="value-section-editorial">
            <div class="section-heading">
                <h2 id="value-title" class="industrial-heading">Built around practical buying needs.</h2>
            </div>
            <div class="value-list-editorial">
                <article class="value-item-editorial">
                    <h3 class="text-xs font-bold uppercase tracking-wider mb-1">Production Supplies</h3>
                    <p>Catalogue organised around the supplies used in print and packaging production.</p>
                </article>
                <article class="value-item-editorial">
                    <h3 class="text-xs font-bold uppercase tracking-wider mb-1">B2B Sourcing</h3>
                    <p>Enquiry-led buying flow for companies, procurement teams and commercial buyers.</p>
                </article>
                <article class="value-item-editorial">
                    <h3 class="text-xs font-bold uppercase tracking-wider mb-1">Availability Enquiry</h3>
                    <p>No live stock claims. Availability and pricing confirmed post-enquiry.</p>
                </article>
                <article class="value-item-editorial">
                    <h3 class="text-xs font-bold uppercase tracking-wider mb-1">Based in Baddi</h3>
                    <p>Druckers Mart Private Limited, serving commercial buyers from Solan, Himachal Pradesh.</p>
                </article>
            </div>
        </section>

        <section aria-labelledby="stages-title" class="stages-section">
            <div class="section-heading section-heading--split">
                <div>
                    <h2 id="stages-title" class="industrial-heading">Find supply by workflow stage.</h2>
                </div>
                <a class="text-link" href="/products">View all products →</a>
            </div>
            <div class="production-editorial-asymmetric">
                {[
                    ['pre-press', 'Pre-press', 'Plates and CTP inputs'],
                    ['press', 'Press', 'Inks, wash and press supplies'],
                    ['post-press', 'Post-press', 'Finishing and packaging supplies'],
                ].map(([stage, label, description], index) => (
                    <a class={`stage-item-editorial ${index === 0 ? 'stage-item-editorial--lead' : ''}`} href={`/products?category=${stage}`}>
                        <h3 class="font-bold mb-1">{label}</h3>
                        <p class="text-sm text-slate-600">{description}</p>
                    </a>
                ))}
            </div>
        </section>

        <section aria-labelledby="featured-title" class="featured-section-editorial">
            <div class="section-heading">
                <h2 id="featured-title" class="industrial-heading">Featured Catalogue</h2>
            </div>
            <div class="featured-editorial-stack">
                <div class="featured-lead">
                    {featuredProducts.length > 0 ? <ProductCard product={featuredProducts[0]} /> : <div class="notice">Catalogue update pending.</div>}
                </div>
                <div class="featured-secondary">
                    {featuredProducts.slice(1).map((product) => <ProductCard product={product} />)}
                    <a class="button button--secondary mt-4" href="/products">View full catalogue →</a>
                </div>
            </div>
        </section>

        <section aria-labelledby="how-title" class="process-section-editorial">
            <div class="section-heading">
                <h2 id="how-title" class="industrial-heading">Simple enquiry flow.</h2>
            </div>
            <div class="process-editorial-list">
                <article class="process-item-editorial">
                    <h3 class="text-lg font-bold mb-1">Find product</h3>
                    <p class="text-sm text-slate-600">Browse by name, stage or specification.</p>
                </article>
                <article class="process-item-editorial">
                    <h3 class="text-lg font-bold mb-1">Check availability</h3>
                    <p class="text-sm text-slate-600">Share your requirement and delivery location.</p>
                </article>
                <article class="process-item-editorial">
                    <h3 class="text-lg font-bold mb-1">Request quote</h3>
                    <p class="text-sm text-slate-600">Team confirms availability/pricing post-enquiry.</p>
                </article>
            </div>
        </section>

        <section aria-labelledby="industries-title" class="use-cases-editorial">
            <div class="section-heading">
                <h2 id="industries-title" class="industrial-heading">For printing and packaging operations.</h2>
            </div>
            <ul class="use-case-list-editorial">
                <li>Commercial Printing</li>
                <li>Packaging Printing</li>
                <li>Offset Printing</li>
                <li>Print Finishing</li>
            </ul>
        </section>

        <section class="final-cta-editorial" aria-labelledby="final-cta-title">
            <h2 id="final-cta-title" class="industrial-heading text-3xl font-bold mb-6">Tell us the product, quantity and delivery location.</h2>
            <div class="actions">
                <a class="button" href="/enquiry">Request Quote</a>
                <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp Enquiry</a>
            </div>
        </section>
    </div>
</SiteLayout>

<style>
/* Hero */
.home-hero { padding-block: var(--space-2xl); border-bottom: 1px solid var(--line); overflow: hidden; }
.home-hero__container { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: center; }
.home-hero__content { display: grid; gap: var(--space-md); }
.home-hero h1 { font-size: clamp(3rem, 6vw, 4.5rem); margin: 0; line-height: 1; }
.home-hero__visual { aspect-ratio: 4/3; border: 1px solid var(--line); overflow: hidden; }

/* Layout */
.home-stack { display: grid; gap: var(--space-3xl); padding-block: var(--space-xl); }
.section-heading { margin-bottom: var(--space-xl); }
.section-heading--split { display: flex; justify-content: space-between; align-items: flex-end; }

/* Supply Board Editorial */
.supply-board-editorial { margin-bottom: 4rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
.supply-board-list { display: flex; gap: 2rem; }
.supply-board-item { display: flex; flex-direction: column; gap: 0.25rem; }

/* Value Editorial */
.value-section-editorial { padding-block: var(--space-xl); }
.value-list-editorial { max-width: 60ch; display: grid; gap: 2rem; }
.value-item-editorial h3 { color: var(--signal-orange); }
.value-item-editorial p { margin: 0; line-height: 1.6; color: #4a545a; font-size: 1rem; }

/* Stages Editorial */
.stages-section { padding-block: var(--space-xl); }
.production-editorial-asymmetric { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
.stage-item-editorial { background: var(--white); padding: 2rem; display: flex; flex-direction: column; text-decoration: none; color: var(--graphite); }
.stage-item-editorial--lead { grid-row: span 2; }
.stage-item-editorial:hover { background: var(--off-white); }

/* Featured Editorial */
.featured-section-editorial { padding-block: var(--space-xl); }
.featured-editorial-stack { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); }
.featured-secondary { display: grid; gap: var(--space-md); }

/* Process Editorial */
.process-section-editorial { padding-block: var(--space-xl); }
.process-editorial-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.process-item-editorial { display: flex; flex-direction: column; gap: 0.5rem; }

/* Use Cases Editorial */
.use-cases-editorial { padding-block: var(--space-xl); }
.use-case-list-editorial { display: flex; flex-wrap: wrap; gap: 2rem 4rem; list-style: none; padding: 0; margin: 0; }
.use-case-list-editorial li { font-weight: 600; font-size: 1.1rem; color: var(--graphite); }

/* Final CTA */
.final-cta-editorial { margin-top: 4rem; padding: 4rem 0; border-top: 1px solid var(--line); text-align: center; }
.final-cta-editorial h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); max-width: 30ch; margin: 0 auto 1.5rem; }
.final-cta-editorial .actions { display: flex; gap: 1rem; justify-content: center; }
.final-cta-editorial .button--secondary { background: transparent; border: 1px solid var(--line); }

@media (max-width: 900px) {
    .home-hero__container { grid-template-columns: 1fr; }
    .production-editorial-asymmetric { grid-template-columns: 1fr; }
    .featured-editorial-stack { grid-template-columns: 1fr; }
    .process-editorial-list { grid-template-columns: 1fr; }
}
</style>
