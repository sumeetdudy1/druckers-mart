---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Returns | Druckers Mart">
  <div class="container">
    <section class="content-hero">
      <div class="content-hero__inner">
        <p class="eyebrow">Returns</p>
        <h1>Order & Returns</h1>
        <p class="lede">This website is a B2B sourcing tool. Final order terms, delivery, and any return or quality arrangements are agreed separately after enquiry. Please raise any order-specific question through an enquiry.</p>
        <a class="button button--secondary" href="/enquiry">Contact through an enquiry</a>
      </div>
    </section>
  </div>
</SiteLayout>
