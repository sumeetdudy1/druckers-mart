---
import SiteLayout from '../layouts/SiteLayout.astro';
import AvailabilitySummary from '../components/AvailabilitySummary.astro';
import { druckersBusiness } from '../data/druckers-business';
---
<SiteLayout title="About | Druckers Mart">
  <div class="container about-page">
    <section class="hero about-hero">
      <h1 class="industrial-heading">Printing and packaging consumables for commercial buyers.</h1>
      <p class="lede">{druckersBusiness.publicDescription}</p>
      <p class="font-mono text-sm text-slate-500 uppercase">{druckersBusiness.location}</p>
    </section>

    <section class="about-section" aria-labelledby="workflow-title">
      <div class="section-heading">
        <h2 id="workflow-title" class="industrial-heading">How the range is organised</h2>
      </div>
      <p class="mb-6">Supplies are grouped around the three stages of the print production workflow.</p>
      <div class="about-workflow-industrial" aria-label="Workflow stages: Pre-press, Press, and Post-press">
        {[
          ['pre-press', 'Pre-press', 'Plates and CTP inputs'],
          ['press', 'Press', 'Inks, wash and press supplies'],
          ['post-press', 'Post-press', 'Finishing and packaging supplies'],
        ].map(([stage, label, description], index) => (
          <a class="about-stage-industrial industrial-card-hover" href={`/products?category=${stage}`} aria-label={`Explore ${label} products`}>
            <span class="about-stage-industrial__number font-mono">0{index + 1}</span>
            <span class="about-stage-industrial__label text-lg font-semibold">{label}</span>
            <span class="about-stage-industrial__description text-sm text-slate-600">{description}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="about-contact-industrial" aria-labelledby="about-contact-title">
      <div class="section-heading">
        <h2 id="about-contact-title" class="industrial-heading">Get in touch</h2>
      </div>
      <div class="about-contact-rail">
        <div class="about-contact-cell">
          <span class="font-mono text-[10px] tracking-wider text-slate-500 uppercase mb-2 block">Voice Contact</span>
          <a class="button button--small justify-center" href="tel:+919****5213">Call +91 99682 75213</a>
        </div>
        <div class="about-contact-cell">
          <span class="font-mono text-[10px] tracking-wider text-slate-500 uppercase mb-2 block">Direct Message</span>
          <a class="button button--small button--secondary justify-center" href="https://wa.me/919968275213" target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <div class="about-contact-cell">
          <span class="font-mono text-[10px] tracking-wider text-slate-500 uppercase mb-2 block">Secure Email</span>
          <a class="button button--small button--secondary justify-center" href="mailto:druckersmart@gmail.com">Email</a>
        </div>
      </div>
    </section>

    <AvailabilitySummary />
  </div>
</SiteLayout>

<style>
  .about-page { padding-block: var(--space-2xl); }
  .about-hero { margin-bottom: var(--space-2xl); }
  .about-section { margin-top: var(--space-2xl); }

  /* Unified Industrial Grid instead of arbitrary arrows */
  .about-workflow-industrial { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .about-stage-industrial { display: flex; flex-direction: column; gap: var(--space-xs); padding: 2rem; background: var(--white); color: var(--graphite); text-decoration: none; }
  .about-stage-industrial__number { color: var(--signal-orange); font-weight: 800; letter-spacing: .1em; font-size: var(--text-xs); }

  /* Contact Rail */
  .about-contact-industrial { margin-top: var(--space-2xl); padding-top: var(--space-2xl); border-top: 1px solid var(--line); }
  .about-contact-rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .about-contact-cell { background: var(--white); padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; }

  @media (max-width: 800px) {
    .about-workflow-industrial { grid-template-columns: 1fr; }
    .about-contact-rail { grid-template-columns: 1fr; }
  }
</style>
