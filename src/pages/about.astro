---
import SiteLayout from '../layouts/SiteLayout.astro';
import AvailabilitySummary from '../components/AvailabilitySummary.astro';
import { druckersBusiness } from '../data/druckers-business';
---
<SiteLayout title="About | Druckers Mart">
  <div class="container">
    <section class="hero">
      <p class="eyebrow">About Druckers Mart</p>
      <h1>Printing and packaging consumables for commercial buyers.</h1>
      <p class="lede">{druckersBusiness.publicDescription}</p>
      <p>{druckersBusiness.location}</p>
    </section>

    <section class="about-section" aria-labelledby="workflow-title">
      <h2 id="workflow-title">How the range is organised</h2>
      <p>Supplies are grouped around the three stages of the print production workflow.</p>
      <div class="about-workflow" aria-label="Workflow stages: Pre-press, Press, and Post-press">
        {[
          ['pre-press', 'Pre-press', 'Plates and CTP inputs'],
          ['press', 'Press', 'Inks, wash and press supplies'],
          ['post-press', 'Post-press', 'Finishing and packaging supplies'],
        ].map(([stage, label, description], index) => <>
          <a class="about-stage" href={`/products?category=${stage}`} aria-label={`Explore ${label} products`}><span class="about-stage__number">0{index + 1}</span><span class="about-stage__label">{label}</span><span class="about-stage__description">{description}</span></a>
          {index < 2 && <span class="about-stage__arrow" aria-hidden="true">→</span>}
        </>)}
      </div>
    </section>

    <section class="about-contact" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title">Get in touch</h2>
      <div class="about-contact-grid">
        <a class="button" href="tel:+919968275213">Call +91 99682 75213</a>
        <a class="button button--secondary" href="https://wa.me/919968275213" target="_blank" rel="noopener">WhatsApp</a>
        <a class="button button--secondary" href="mailto:druckersmart@gmail.com">Email</a>
      </div>
    </section>

    <AvailabilitySummary />
  </div>
</SiteLayout>
<style>
  .about-section { max-width: 52rem; margin-top: 3rem; }
  .about-workflow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 1rem; align-items: start; margin-top: 2rem; }
  .about-stage { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem; border: 1px solid var(--line); background: #fff; color: var(--graphite); text-decoration: none; border-radius: 8px; }
  .about-stage__number { color: var(--signal-orange); font-weight: 800; letter-spacing: .1em; font-size: .85rem; }
  .about-stage__label { font-weight: 800; font-size: 1.1rem; }
  .about-stage__description { color: var(--mineral-blue); font-size: .9rem; line-height: 1.4; }
  .about-stage__arrow { color: var(--signal-orange); font-size: 1.5rem; }
  .about-contact { margin-top: 4rem; padding: 2rem; background: var(--off-white); border-radius: 8px; }
  .about-contact-grid { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
  @media (max-width: 640px) { .about-workflow { grid-template-columns: 1fr; gap: 1rem; } .about-stage__arrow { transform: rotate(90deg); justify-self: center; } }
</style>