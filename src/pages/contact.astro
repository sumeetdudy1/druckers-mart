---
import SiteLayout from '../layouts/SiteLayout.astro';
import AvailabilitySummary from '../components/AvailabilitySummary.astro';
import { druckersBusiness } from '../data/druckers-business';
---
<SiteLayout title="Contact | Druckers Mart">
  <div class="container contact-page">
    <section class="hero contact-hero">
      <h1 class="industrial-heading">Request a quote or check availability.</h1>
      <p class="lede">Tell us the product, quantity and delivery location so availability can be confirmed after your enquiry or order.</p>
    </section>

    <section class="contact-section-industrial" aria-labelledby="contact-title">
      <div class="section-heading">
        <h2 id="contact-title" class="industrial-heading">Other ways to reach us</h2>
      </div>

      <div class="contact-dual-rail">
        <div class="contact-panel-primary">
          <span class="contact-label">Formal enquiry</span>
          <h3>Start an enquiry</h3>
          <p>Tell us the product, quantity and delivery location so availability can be confirmed after your enquiry or order.</p>
          <a class="button" href="/enquiry">Start an enquiry</a>
        </div>

        <div class="contact-panel-secondary">
          <div class="contact-channel-grid">
            <div class="contact-channel-cell">
              <span class="contact-label">Phone / WhatsApp</span>
              <h3>+91 99682 75213</h3>
              <p>Same number for calls and WhatsApp messages.</p>
              <div class="contact-channel-actions">
                <a class="button button--small" href={`tel:${druckersBusiness.phone}`}>Call +91 99682 75213</a>
                <a class="button button--small button--secondary" href={`https://wa.me/${druckersBusiness.whatsapp.replace('+', '')}`} target="_blank" rel="noopener">WhatsApp</a>
              </div>
            </div>

            <div class="contact-channel-cell">
              <span class="contact-label">Email</span>
              <h3>{druckersBusiness.email}</h3>
              <p>Expect a response within one business day.</p>
              <a class="button button--small button--secondary" href={`mailto:${druckersBusiness.email}`}>Email</a>
            </div>

            <div class="contact-channel-cell">
              <span class="contact-label">Office</span>
              <h3>{druckersBusiness.legalName}</h3>
              <p>{druckersBusiness.location}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <AvailabilitySummary />
  </div>
</SiteLayout>

<style>
  .contact-page { padding-block: var(--space-2xl); }
  .contact-hero { margin-bottom: var(--space-2xl); }

  .contact-section-industrial { margin-top: var(--space-2xl); }
  .contact-dual-rail { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); align-items: start; }

  .contact-label {
    display: block;
    margin-bottom: 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mineral-blue);
  }

  .contact-panel-primary {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 2rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .contact-panel-primary h3 { margin: 0; font-size: var(--text-2xl); }
  .contact-panel-primary p { margin: 0 0 0.5rem; color: #4a545a; line-height: 1.5; }

  .contact-channel-grid { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .contact-channel-cell { background: var(--white); padding: 1.5rem; display: grid; gap: 0.5rem; }
  .contact-channel-cell h3 { margin: 0; font-size: var(--text-lg); }
  .contact-channel-cell p { margin: 0; color: #4a545a; font-size: var(--text-sm); line-height: 1.5; }
  .contact-channel-actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); margin-top: 0.5rem; }
  .contact-channel-actions .button,
  .contact-channel-cell > .button { justify-content: center; }

  @media (max-width: 900px) {
    .contact-dual-rail { grid-template-columns: 1fr; gap: var(--space-lg); }
    .contact-panel-primary { padding: 1.5rem; }
  }

  @media (max-width: 520px) {
    .contact-channel-actions { grid-template-columns: 1fr; }
  }
</style>
