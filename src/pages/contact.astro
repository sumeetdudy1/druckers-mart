---
import SiteLayout from '../layouts/SiteLayout.astro';
import AvailabilitySummary from '../components/AvailabilitySummary.astro';
import { druckersBusiness } from '../data/druckers-business';
---
<SiteLayout title="Contact | Druckers Mart">
  <div class="container contact-page">
    <section class="content-hero">
      <div class="content-hero__inner">
        <p class="eyebrow">Contact</p>
        <h1 class="industrial-heading">Request a quote or check availability.</h1>
        <p class="lede">Tell us the product, quantity and delivery location so availability can be confirmed after your enquiry or order.</p>
      </div>
    </section>

    <section class="contact-editorial" aria-labelledby="contact-title">
      <div class="section-heading">
        <h2 id="contact-title" class="industrial-heading">Ways to reach us</h2>
      </div>

      <div class="contact-editorial-layout">
        <div class="contact-editorial-panel">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Formal enquiry</span>
          <h3>Start an enquiry</h3>
          <p class="text-sm text-slate-600">Tell us the product, quantity and delivery location so availability can be confirmed.</p>
          <a class="button" href="/enquiry">Start an enquiry</a>
        </div>

        <ul class="contact-editorial-list">
          <li class="contact-editorial-item">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Phone / WhatsApp</span>
            <h3>{druckersBusiness.phone}</h3>
            <p class="text-sm text-slate-600">Same number for calls and WhatsApp messages.</p>
            <div class="contact-channel-actions">
              <a class="button button--small" href={`tel:${druckersBusiness.phone}`}>Call</a>
              <a class="button button--small button--secondary" href={`https://wa.me/${druckersBusiness.whatsapp.replace('+', '')}`} target="_blank" rel="noopener">WhatsApp</a>
            </div>
          </li>
          <li class="contact-editorial-item">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Email</span>
            <h3>{druckersBusiness.email}</h3>
            <p class="text-sm text-slate-600">Expect a response within one business day.</p>
            <a class="button button--small button--secondary" href={`mailto:${druckersBusiness.email}`}>Email</a>
          </li>
          <li class="contact-editorial-item">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Office</span>
            <h3>{druckersBusiness.legalName}</h3>
            <p class="text-sm text-slate-600">{druckersBusiness.location}</p>
          </li>
        </ul>
      </div>
    </section>

    <AvailabilitySummary />
  </div>
</SiteLayout>

<style>
  .contact-page { padding-block: var(--space-2xl); }
  .contact-editorial { margin-top: var(--space-2xl); }
</style>
