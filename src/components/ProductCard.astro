---
import type { ProductRecord } from '../data/product-schema';
import AvailabilityBadge from './AvailabilityBadge.astro';
import { productCategoryLabel } from '../data/products';
const { product } = Astro.props as { product: ProductRecord };
const verifiedSpecs = Object.entries(product.specs ?? {}).filter(([, field]) => field.verified);
const categoryLabel = productCategoryLabel(product.category);
const initials = product.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
const whatsappMsg = encodeURIComponent(`Hi Druckers Mart, I would like to enquire about ${product.name}.`);
---
<article class:list={["card", `card--${product.category}`]} data-product-card data-category={product.category} data-availability={product.availability_status} data-search={`${product.name} ${product.category} ${verifiedSpecs.map(([key, field]) => `${key} ${field.value}`).join(' ')}`.toLowerCase()}>
  <div class="card__header">
    {product.imagePath ? (
      <div class="card__image">
        <img src={product.imagePath} alt={product.name} loading="lazy" />
      </div>
    ) : (
      <div class={`card__image product-placeholder product-placeholder--${product.category}`}>{initials}</div>
    )}
  </div>

  <div class="card__content">
    <div class="card__identity">
      <p class="eyebrow card__category">{categoryLabel}</p>
      <h3 class="card__title industrial-heading"><a href={`/products/${product.id}`}>{product.name}</a></h3>
      <AvailabilityBadge status={product.availability_status} />
    </div>

    {verifiedSpecs.length > 0 && (
      <div class="card__specs">
        <p class="card__specs-title">Key Specifications</p>
        <div class="card__specs-grid">
          {verifiedSpecs.map(([key, field]) => (
            <div class="card__spec">
              <span class="card__spec-label">{key.replaceAll('_', ' ')}</span>
              <span class="card__spec-value">{field.value}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="card__actions">
    <a class="button" href={`/enquiry?product=${product.id}`}>Request Quote</a>
    <a class="whatsapp-text" href={`https://wa.me/919968275213?text=${whatsappMsg}`} target="_blank" rel="noopener" aria-label={`WhatsApp about ${product.name}`}>WhatsApp</a>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--white);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: var(--mineral-blue);
    }
  }
  .card:focus-within {
    outline: 3px solid var(--signal-orange);
    outline-offset: 3px;
  }

  .card__header { padding: 0; }
  .card__image { border-radius: 0; overflow: hidden; height: 160px; }
  .card__image img { width: 100%; height: 100%; object-fit: cover; }
  .product-placeholder { height: 160px; display: grid; place-items: center; color: var(--white); font-size: 3rem; }
  .card__identity { padding: var(--space-md) var(--space-lg) 0; display: grid; gap: var(--space-xs); }
  .card__category { margin: 0; font-size: var(--text-xs); color: var(--mineral-blue); }
  .card__title { margin: 0; font-size: var(--text-xl); font-weight: 700; line-height: 1.2; color: var(--graphite); }
  .card__title a { color: inherit; text-decoration: none; }
  .card__title a:hover { color: var(--signal-orange); }
  .card__title a:focus-visible { outline: 3px solid var(--signal-orange); outline-offset: 3px; }

  .card__specs { border-top: 1px solid var(--line); padding: var(--space-md) var(--space-lg); }
  .card__specs-title { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mineral-blue); margin-bottom: var(--space-sm); }
  .card__specs-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xs); }
  .card__spec { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); }
  .card__spec-label { font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; color: var(--mineral-blue); white-space: nowrap; }
  .card__spec-value { font-size: var(--text-sm); font-weight: 500; color: var(--graphite); }

  .card__actions { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-md) var(--space-lg) var(--space-lg); }
  .whatsapp-text { font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; color: var(--mineral-blue); text-decoration: underline; text-align: center; }

  @media (min-width: 520px) {
    .card__actions { flex-direction: row; align-items: center; justify-content: space-between; }
    .whatsapp-text { text-align: right; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transition: none; transform: none; box-shadow: none; }
  }
</style>
