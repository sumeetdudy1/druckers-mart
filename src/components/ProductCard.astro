---
import type { ProductRecord } from '../data/product-schema';
import AvailabilityBadge from './AvailabilityBadge.astro';
import { productCategoryLabel } from '../data/products';
const { product } = Astro.props as { product: ProductRecord };
const verifiedSpecs = Object.entries(product.specs ?? {}).filter(([, field]) => field.verified);
const categoryLabel = productCategoryLabel(product.category);
const initials = product.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
const whatsappMsg = encodeURIComponent(`Hi Druckers Mart, I would like to enquire about ${product.name}.`);
---
<article class:list={["card", `card--${product.category}`]} data-product-card data-category={product.category} data-availability={product.availability_status} data-search={`${product.name} ${product.category} ${verifiedSpecs.map(([key, field]) => `${key} ${field.value}`).join(' ')}`.toLowerCase()}>
  <div class="card__header">
    {product.imagePath ? (
      <div class="card__image">
        <img src={product.imagePath} alt={product.name} loading="lazy" />
      </div>
    ) : (
      <div class={`card__image product-placeholder product-placeholder--${product.category}`}>{initials}</div>
    )}
    <p class="eyebrow card__category">{categoryLabel}</p>
    <h3><a href={`/products/${product.id}`}>{product.name}</a></h3>
    <AvailabilityBadge status={product.availability_status} />
  </div>

  {verifiedSpecs.length > 0 && (
    <div class="card__specs">
      <dl>
        {verifiedSpecs.map(([key, field]) => (
          <div>
            <dt>{key.replaceAll('_', ' ')}</dt>
            <dd>{field.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}

  <div class="card__actions">
    <a class="button" href={`/enquiry?product=${product.id}`}>Request Quote</a>
    <a class="button button--secondary whatsapp-btn" href={`https://wa.me/919968275213?text=${whatsappMsg}`} target="_blank" rel="noopener" aria-label={`WhatsApp about ${product.name}`}>WhatsApp</a>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-base);
  }
  .card__header { display: flex; flex-direction: column; gap: var(--space-sm); }
  .card__image { margin-bottom: var(--space-sm); border-radius: var(--radius-sm); overflow: hidden; }
  .card__image img { width: 100%; height: 160px; object-fit: cover; }
  .product-placeholder { height: 160px; display: grid; place-items: center; color: var(--white); font-size: 3rem; }
  .card__category { margin: 0; font-size: var(--text-xs); color: var(--mineral-blue); }
  .card__header h3 { margin: 0; font-size: var(--text-lg); line-height: 1.2; }
  .card__header h3 a { color: var(--graphite); text-decoration: none; }
  .card__header h3 a:hover { color: var(--signal-orange); }
  
  .card__specs { border-top: 1px solid var(--line); padding-top: var(--space-md); margin-top: var(--space-sm); }
  .card__specs dl { margin: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .card__specs dl div { display: flex; justify-content: space-between; gap: var(--space-sm); }
  .card__specs dt { color: #64748b; text-transform: capitalize; font-size: var(--text-xs); }
  .card__specs dd { margin: 0; font-weight: 600; font-size: var(--text-sm); color: var(--graphite); }
  
  .card__actions { display: grid; grid-template-columns: 1fr auto; gap: var(--space-sm); margin-top: var(--space-md); }
  .whatsapp-btn { padding-inline: var(--space-md); }
  
  .card--pre-press { border-top: 4px solid var(--stage-pre-press); }
  .card--press { border-top: 4px solid var(--stage-press); }
  .card--post-press { border-top: 4px solid var(--stage-post-press); }
</style>
