---
import '../styles/global.css';
import { druckersBusiness } from '../data/druckers-business';
const { title = 'Druckers Mart', description = 'Druckers Mart product catalogue and availability enquiry.' } = Astro.props;
const phoneDisplay = '+91 99682 75213';
const whatsappUrl = `https://wa.me/${druckersBusiness.whatsapp.replace('+', '')}`;
const commit = import.meta.env.COMMIT_SHA || "unknown";
---
<!doctype html>
<html lang="en">
  <head>
    <meta name="druckers-version" content="0.6.0" />
    <meta name="druckers-commit" content={import.meta.env.SOURCE_COMMIT} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://druckersmart.com${Astro.url.pathname}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Druckers Mart" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://druckersmart.com${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Druckers Mart",
      "url": "https://druckersmart.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://druckersmart.com/products?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Druckers Mart Private Limited",
      "url": "https://druckersmart.com",
      "email": druckersBusiness.email,
      "telephone": druckersBusiness.phone,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Baddi",
        "addressRegion": "Solan",
        "addressCountry": "IN"
      }
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href="/" aria-label="Druckers Mart home">
          <span class="wordmark__mark">DM</span>
          <span class="wordmark__text">Druckers Mart</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="menu-toggle__label">Menu</span>
          <span class="menu-toggle__icon" aria-hidden="true">☰</span>
        </button>
        <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation">
          <a href="/products">Products</a>
          <a href="/about">About</a>
          <a href="/resources">Resources</a>
          <a href="/contact">Contact</a>
          <a class="site-nav__mobile-contact" href={`tel:${druckersBusiness.phone}`}>{phoneDisplay}</a>
          <a class="site-nav__mobile-contact" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
          <a class="button button--small site-nav__cta" href="/enquiry">Request Quote</a>
        </nav>
        <div class="site-header__contact" aria-label="Contact options">
          <a class="header-phone" href={`tel:${druckersBusiness.phone}`}>{phoneDisplay}</a>
          <a class="button button--small header-quote" href="/enquiry">Request Quote</a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="site-footer__brand">Druckers Mart Private Limited</p>
          <p>{druckersBusiness.location}</p>
          <p><a href={`tel:${druckersBusiness.phone}`}>{phoneDisplay}</a> · <a href={`mailto:${druckersBusiness.email}`}>{druckersBusiness.email}</a></p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer navigation">
          <a href="/products">Products</a>
          <a href="/resources">Resources</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/returns">Returns</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </footer>
    <script>
      const header = document.querySelector('.site-header');
      const menuButton = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
      const navigation = document.querySelector('#primary-navigation');
      if (header && menuButton && navigation) {
        header.setAttribute('data-menu-ready', 'true');
        menuButton.addEventListener('click', () => {
          const open = menuButton.getAttribute('aria-expanded') === 'true';
          menuButton.setAttribute('aria-expanded', String(!open));
          header.setAttribute('data-menu-open', String(!open));
        });
      }
    </script>
  </body>
</html>
